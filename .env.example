# 카카오 개발자 콘솔 > 앱 설정 > 앱 키 > JavaScript 키
VITE_KAKAO_JS_KEY=

# 카카오 콘솔 > 카카오 로그인 > Redirect URI 에 등록한 값과 문자열까지 같아야 한다.
# 로컬 기본값: http://localhost:5173/oauth/kakao
VITE_KAKAO_REDIRECT_URI=http://localhost:5173/oauth/kakao

# 비우면 /api 로 요청하고 vite 프록시가 백엔드로 넘긴다 (로컬 권장).
# 배포 시에는 백엔드 주소를 직접 넣거나 호스팅 rewrites 를 쓴다.
VITE_API_BASE_URL=
